# Dedicated Automation Studio database; required for hosted execution.
DATABASE_URL=
STUDIO_DATA_DIR=.data/automation-studio
STUDIO_ORIGIN=http://localhost:3211
MEZO_RPC_URL=https://rpc.test.mezo.org

# Keep execution disabled until the owner has approved the account and limits.
STUDIO_AUTOMATION_EXECUTION=false
STUDIO_EXECUTOR_ADDRESS=
STUDIO_EXECUTOR_PRIVATE_KEY=
STUDIO_AUTOMATION_CONFIRMATIONS=2
STUDIO_V2_BATCH_DEPLOYMENT=false
STUDIO_V2_BATCH_EXECUTION=false

# Optional hosted scheduler and integrations. Set through your host's secret store.
STUDIO_SCHEDULER_SECRET=
STUDIO_WEBHOOK_ENCRYPTION_KEY=
STUDIO_REPAYMENT_SIGNING_SECRET=
